{
  "name": "stonewake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/fetch-assets.mjs",
    "relay": "npm --prefix server run dev",
    "relay:check": "node scripts/relay-check.mjs",
    "relay:deploy": "npm --prefix server run deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/cinzel": "^5.3.0",
    "chess.js": "^1.4.0",
    "n8ao": "^2.1.0",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
